# Microsoft delegated OAuth (server-only)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/integrations/outlook/callback

# Gemini (server-only)
# Use a value beginning with mock- to exercise the deterministic local adapter.
GEMINI_API_KEY=mock-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Google Meet + Calendar (server-only)
# Use a value beginning with mock- for the no-network integration test. A live
# delegated token needs userinfo.email, calendar.events.readonly, and
# meetings.space.readonly scopes.
GOOGLE_MEET_ACCESS_TOKEN=mock-google-access-token
GOOGLE_MEET_DEFAULT_PROJECT_ID=habitat-life-support
GOOGLE_PUBSUB_TOPIC=projects/seen-demo/topics/meet-events
# Configure the Pub/Sub push URL as /api/integrations/google-meet/webhook?token=<this value>.
GOOGLE_PUBSUB_PUSH_TOKEN=mock-webhook-secret

# Seen server security and persistence
# Generate 32 random bytes and encode them as base64.
APP_ENCRYPTION_KEY=
SEEN_SESSION_SECRET=
SEEN_DATABASE_PATH=data/seen-proof.db

# The fixture-only product remains available when this is true.
# Real integration endpoints still stay unavailable until all required secrets exist.
SEEN_DEMO_MODE=true
NEXT_PUBLIC_LANDING_URL=http://localhost:5174/
